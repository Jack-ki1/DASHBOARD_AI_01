# Copy to `.env` and fill in. Never commit real secrets.
# Server port (frontend dev proxy expects 4000).
PORT=4000

# SQLite file. Defaults to ./data/app.db inside backend/.
DATABASE_PATH=./data/app.db

# Comma-separated origins allowed to call the API in a browser.
CORS_ORIGIN=http://localhost:5173

# Auth. JWT_SECRET is required in production; without it the server only
# starts with an insecure dev default and logs a warning.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# AI provider (any OpenAI-compatible chat-completions endpoint).
# Leave unset to run the API in demo mode: /api/ai/* answer 503
# AI_NOT_CONFIGURED and the frontend uses labeled local generation.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# When set, the backend serves the built frontend from this directory.
FRONTEND_DIST=../frontend/dist
